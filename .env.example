# ============================================
# 推荐做法：把配置写进 config.json（见 config.example.json）
#   cp config.example.json config.json  # 然后填 deepseekKey
# config.json 已被 .gitignore / .dockerignore 排除，不会进仓库和镜像
# 下面的环境变量优先级高于 config.json，适合容器/CI 场景
# ============================================

# 服务端口
PORT=3000

# DeepSeek 密钥（AI 生成菜谱、搜图审图）
DEEPSEEK_API_KEY=

# 可选：正版图库 key（配置后优先使用，可商用授权）
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# JWT 签名密钥（生产环境务必修改，openssl rand -hex 32）
JWT_SECRET=

# 数据与上传目录（默认 ./data 与 ./uploads）
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
